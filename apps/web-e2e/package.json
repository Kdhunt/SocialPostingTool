{
  "name": "@ward-comms/web-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --workers=1",
    "test:e2e:save-session": "playwright test -c playwright.capture.config.ts --headed --workers=1",
    "mock-ward:reset": "tsx mock-ward/reset-db.ts",
    "test:e2e:local": "playwright test -c playwright.local.config.ts",
    "test:e2e:local:headed": "playwright test -c playwright.local.config.ts --headed --workers=1",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@ward-comms/api-client": "workspace:*",
    "@types/node": "^20.14.15",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
