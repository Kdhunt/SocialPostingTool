# Copy to .env in this folder (gitignored) or export in your shell.
# Never commit real passwords or ward codes.

# Against a deployed site (does not start a local Nuxt server):
# E2E_BASE_URL=https://www.wardcomms.online
#
# Headed live run (uses this folder's .env):
#   pnpm --filter @ward-comms/web-e2e test:e2e:headed -- --project=setup --project=authenticated

# Required for authenticated browser tests unless you save a session:
# E2E_USERNAME=
# E2E_PASSWORD=
# E2E_WARD_CODE=

# Reuse a signed-in browser (gitignored apps/web-e2e/.auth/user.json):
#   pnpm --filter @ward-comms/web-e2e test:e2e:save-session
# Sign in in the headed window, or connect to Chrome DevTools:
# E2E_CDP_URL=http://127.0.0.1:9222
# E2E_USE_CDP=1
