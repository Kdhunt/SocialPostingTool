{
  "name": "ward-communications-hub",
  "private": true,
  "version": "0.1.0",
  "description": "Ward Communications Hub monorepo",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "build:vercel": "tsx scripts/vercel-build.ts",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test && pnpm run test:scripts",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "test:e2e": "pnpm --filter @ward-comms/web-e2e test:e2e",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf node_modules",
    "db:seed:dev": "pnpm --filter @ward-comms/database db:seed:dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.27.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vue-eslint-parser": "^9.4.3",
    "@ward-comms/config": "workspace:*",
    "@vercel/nft": "^0.29.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0"
  }
}
