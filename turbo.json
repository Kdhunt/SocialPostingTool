{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["**/.env"],
  "globalEnv": [
    "NUXT_PUBLIC_API_BASE_URL",
    "NODE_ENV",
    "DATABASE_URL",
    "POSTGRES_PRISMA_URL",
    "PRISMA_DATABASE_URL",
    "POSTGRES_URL",
    "POSTGRES_URL_NON_POOLING",
    "REDIS_URL",
    "UPSTASH_REDIS_URL",
    "SESSION_SECRET",
    "REFRESH_TOKEN_SECRET",
    "WARD_CODE_PEPPER",
    "PROVIDER_CREDENTIALS_ENCRYPTION_KEY",
    "CRON_SECRET",
    "VERCEL_URL",
    "VERCEL",
    "VERCEL_ENV",
    "BOOTSTRAP_ADMIN_USERNAME",
    "BOOTSTRAP_ADMIN_PASSWORD",
    "BOOTSTRAP_WARD_CODE",
    "BOOTSTRAP_WARD_NAME",
    "BOOTSTRAP_ADMIN_DISPLAY_NAME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".output/**",
        ".nuxt/**",
        ".vercel/output/**",
        "www/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    }
  }
}
