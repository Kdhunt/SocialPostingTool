# Copy this file to .env and fill in real values for local development.
# NEVER commit a real .env file. NEVER put real secrets in this template.

# --- General ---
NODE_ENV=development
APP_NAME=Ward Communications Hub
# IANA time zone used to DISPLAY timestamps to users. All stored timestamps remain UTC.
WARD_TIME_ZONE=America/Denver

# --- API app (apps/api) ---
API_HOST=0.0.0.0
API_PORT=3001
API_URL=http://localhost:3001

# --- Web app (apps/web) ---
WEB_PORT=3000
WEB_URL=http://localhost:3000
# Base URL the web app uses to reach the API from the browser.
# Leave unset on Vercel (same domain). Local dev points at the NestJS port.
# NUXT_PUBLIC_API_BASE_URL=
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001

# --- Worker app (apps/worker) ---
WORKER_HEALTH_PORT=3002
# How often the worker polls for due CampaignSchedule rows (milliseconds).
SCHEDULE_POLL_INTERVAL_MS=60000

# --- Database (packages/database) ---
# Local Docker Compose default. On Vercel, PRISMA_DATABASE_URL is mapped automatically.
DATABASE_URL=postgresql://ward_comms:ward_comms_dev_password@localhost:5432/ward_comms_dev
# PRISMA_DATABASE_URL=   # Set by Vercel Prisma Postgres integration
# POSTGRES_URL=           # Direct URL from Vercel (used for migrations in build)

# --- Redis / BullMQ (apps/worker, apps/api) ---
REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_URL=     # Set by Upstash integration (API project)

# --- Vercel production bootstrap (first admin — remove after first deploy) ---
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=        # min 12 characters
# BOOTSTRAP_WARD_CODE=
# BOOTSTRAP_WARD_NAME=             # optional
# BOOTSTRAP_ADMIN_DISPLAY_NAME=    # optional
# CRON_SECRET=             # Required in production on Vercel (openssl rand -base64 32)

# --- Session / auth secrets (placeholders only, generate real values locally) ---
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-min-32-chars
# Generate with: openssl rand -base64 48
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string

# --- Ward code hashing (placeholder, never store ward codes in readable form) ---
WARD_CODE_PEPPER=replace-with-a-long-random-string

# --- Provider credentials encryption (AES-256-GCM; generate: openssl rand -base64 32) ---
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=dev-only-provider-credentials-key!!
# simulated = magic-value adapters (no credentials)
# credentialed = require encrypted credentials, then simulate send
# live = require encrypted credentials, call real provider APIs (SendGrid/SMTP, Twilio, Facebook Graph)
PROVIDER_MODE=simulated

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
