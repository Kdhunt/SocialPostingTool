// Ward Communications Hub — Phase 3 domain schema.
//
// See docs/domain-model.md for the entity relationship diagram, constraint
// rationale, and the seed data this schema ships with. See AGENTS.md and
// .cursor/rules/ for the binding privacy, security, and architecture rules
// this schema must uphold (never store secrets in readable form, never
// physically delete audit/delivery history, never infer consent, etc.).
//
// Conventions used throughout this file:
// - Table names are singular and snake_case via @@map.
// - Column names are snake_case via @map; model fields stay camelCase.
// - Every model has createdAt/updatedAt except pure append-only logs
//   (AuditEvent) and thin join rows where only createdAt is meaningful.
// - `archivedAt` (nullable) is a soft-archive marker used wherever history
//   must be preserved instead of physically deleted. Rows are never deleted
//   when other records (audit, delivery, consent) depend on their identity.
// - Identifiers are UUID strings generated by the application/database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// A single ward (congregation) tenant. All directory, audience, and
/// communication data is scoped to a ward. Wards are archived, never
/// deleted, because historical audit and delivery data must survive.
model Ward {
  id         String    @id @default(uuid())
  name       String
  timeZone   String    @default("America/Denver") @map("time_zone")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  users                     ApplicationUser[]
  wardCodeVersions          WardCodeVersion[]
  people                    Person[]
  households                Household[]
  audienceGroups            AudienceGroup[]
  communicationDestinations CommunicationDestination[]
  campaigns                 Campaign[]
  deliveryBatches           DeliveryBatch[]
  auditEvents               AuditEvent[]

  @@map("ward")
}

// ---------------------------------------------------------------------------
// Authorization (roles/permissions schema only — Phase 4 implements auth)
// ---------------------------------------------------------------------------

/// A named role granted to users (e.g. WardAdmin, CommunicationsCoordinator).
/// Roles are global (not per-ward) and seeded; see prisma/seed.ts.
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("role")
}

/// A single grantable capability (e.g. "directory.read"). Permissions are
/// seeded and composed into roles via RolePermission.
model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permission")
}

/// Many-to-many join between Role and Permission. Not explicitly named in
/// the Phase 3 entity list, but required so Role and Permission can express
/// the RBAC relationship the seed data and Phase 4 authorization depend on.
model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

// ---------------------------------------------------------------------------
// Users, sessions, and ward code (schema only — Phase 4 implements the flows)
// ---------------------------------------------------------------------------

/// An individual login identity scoped to one ward. Password and ward code
/// values are never stored in readable form — only salted hashes.
model ApplicationUser {
  id                  String    @id @default(uuid())
  wardId              String    @map("ward_id")
  username            String
  email               String?
  displayName         String    @map("display_name")
  /// Argon2id hash of the user's password. Never expose via API responses.
  passwordHash        String    @map("password_hash")
  passwordAlgo        String    @default("argon2id") @map("password_algo")
  passwordUpdatedAt   DateTime? @map("password_updated_at")
  /// Counts consecutive failed attempts; the attempted password itself is
  /// never recorded (see AGENTS.md #2 and .cursor/rules/security.mdc).
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedLoginAt   DateTime? @map("last_failed_login_at")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  /// Administrator-initiated disable (distinct from archival on removal).
  disabledAt          DateTime? @map("disabled_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  archivedAt          DateTime? @map("archived_at")

  ward                    Ward                  @relation(fields: [wardId], references: [id], onDelete: Restrict)
  roles                   UserRole[]
  sessions                UserSession[]
  auditEvents             AuditEvent[]
  recordedConsents        ContactConsent[]
  addedAudienceMembers    AudienceGroupMember[]
  createdCampaigns        Campaign[]            @relation("CampaignCreatedBy")
  createdCampaignVersions CampaignVersion[]     @relation("CampaignVersionCreatedBy")
  campaignApprovals       CampaignApproval[]    @relation("CampaignApprovalApprover")
  campaignSchedules       CampaignSchedule[]    @relation("CampaignScheduleCreatedBy")
  createdDeliveryBatches  DeliveryBatch[]

  @@unique([wardId, username])
  @@unique([wardId, email])
  @@index([wardId])
  @@map("application_user")
}

/// Many-to-many join between ApplicationUser and Role.
model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user ApplicationUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

/// A browser or mobile login session. Only hashes of session/refresh tokens
/// are stored — never the raw token value. `deviceId` and
/// `wardCodeVersionId` support Phase 4's "ward code required again after
/// rotation, or on a new device" rule.
model UserSession {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  sessionTokenHash  String    @unique @map("session_token_hash")
  refreshTokenHash  String?   @unique @map("refresh_token_hash")
  deviceId          String?   @map("device_id")
  wardCodeVersionId String?   @map("ward_code_version_id")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")
  createdAt         DateTime  @default(now()) @map("created_at")
  lastUsedAt        DateTime? @map("last_used_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")

  user            ApplicationUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  wardCodeVersion WardCodeVersion? @relation(fields: [wardCodeVersionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
  @@map("user_session")
}

/// A rotation of the shared ward code. Only the hash is stored. Exactly one
/// version per ward should have `retiredAt` null (the active version); this
/// invariant is enforced by the Phase 4 application service, not the schema.
model WardCodeVersion {
  id          String    @id @default(uuid())
  wardId      String    @map("ward_id")
  version     Int
  /// Hash of the ward code combined with WARD_CODE_PEPPER. Never store the
  /// raw ward code.
  codeHash    String    @map("code_hash")
  createdAt   DateTime  @default(now()) @map("created_at")
  activatedAt DateTime? @map("activated_at")
  retiredAt   DateTime? @map("retired_at")

  ward     Ward          @relation(fields: [wardId], references: [id], onDelete: Restrict)
  sessions UserSession[]

  @@unique([wardId, version])
  @@index([wardId, retiredAt])
  @@map("ward_code_version")
}

// ---------------------------------------------------------------------------
// Directory: people, households, relationships, contact, consent
// ---------------------------------------------------------------------------

/// A ward member or contact. `archivedAt` marks inactive/removed people
/// without losing history that other records (households, audiences, audit
/// events) reference. Date of birth is retained but access must be
/// restricted by role at the application layer (see AGENTS.md #14 and
/// .cursor/rules/security.mdc).
model Person {
  id            String    @id @default(uuid())
  wardId        String    @map("ward_id")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  preferredName String?   @map("preferred_name")
  gender        Gender    @default(NotSpecified)
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  archivedAt    DateTime? @map("archived_at")

  ward                 Ward                  @relation(fields: [wardId], references: [id], onDelete: Restrict)
  householdMemberships HouseholdMembership[]
  relationshipsFrom    PersonRelationship[]  @relation("PersonRelationshipFrom")
  relationshipsTo      PersonRelationship[]  @relation("PersonRelationshipTo")
  contactMethods       ContactMethod[]
  audienceMemberships  AudienceGroupMember[]
  deliveryRecipients   DeliveryRecipient[]

  @@index([wardId, lastName, firstName])
  @@index([wardId, archivedAt])
  @@map("person")
}

/// A residential household. Households are soft-archived, never deleted,
/// so historical membership and communication records remain valid.
model Household {
  id           String    @id @default(uuid())
  wardId       String    @map("ward_id")
  name         String
  addressLine1 String?   @map("address_line1")
  addressLine2 String?   @map("address_line2")
  city         String?
  state        String?
  postalCode   String?   @map("postal_code")
  country      String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  archivedAt   DateTime? @map("archived_at")

  ward        Ward                  @relation(fields: [wardId], references: [id], onDelete: Restrict)
  memberships HouseholdMembership[]

  @@index([wardId])
  @@map("household")
}

/// Residency of a Person in a Household. This is intentionally SEPARATE
/// from PersonRelationship: `householdRole` captures an administrative role
/// within the household (e.g. Head vs. Member) while family relationship
/// (husband/wife/parent/child/etc.) lives on PersonRelationship. A person
/// may have only one row per household (see @@unique); moving out and back
/// in reuses the row by clearing `endedAt` rather than inserting a
/// duplicate. `endedAt` is the soft-archive marker for this model — a null
/// value means the residency is current.
model HouseholdMembership {
  id            String        @id @default(uuid())
  householdId   String        @map("household_id")
  personId      String        @map("person_id")
  householdRole HouseholdRole @default(Member) @map("household_role")
  startedAt     DateTime      @default(now()) @map("started_at")
  endedAt       DateTime?     @map("ended_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, householdId])
  @@index([householdId])
  @@index([personId, endedAt])
  @@map("household_membership")
}

/// A directed family relationship from `person` to `relatedPerson` (e.g.
/// personId is the Husband of relatedPersonId). Relationship types
/// intentionally do not assume one permanent family shape (divorce,
/// remarriage, guardianship, and single-parent households are all
/// representable). `archivedAt` ends a relationship without deleting it —
/// a new relationship row (e.g. to a new spouse) can then be added because
/// the uniqueness constraint only applies per relatedPerson/type pair, not
/// per person. The application layer must reject personId == relatedPersonId
/// (not expressible as a Postgres CHECK constraint in this Prisma version).
model PersonRelationship {
  id               String           @id @default(uuid())
  personId         String           @map("person_id")
  relatedPersonId  String           @map("related_person_id")
  relationshipType RelationshipType @map("relationship_type")
  startedAt        DateTime         @default(now()) @map("started_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  archivedAt       DateTime?        @map("archived_at")

  person        Person @relation("PersonRelationshipFrom", fields: [personId], references: [id], onDelete: Cascade)
  relatedPerson Person @relation("PersonRelationshipTo", fields: [relatedPersonId], references: [id], onDelete: Cascade)

  @@unique([personId, relatedPersonId, relationshipType])
  @@index([relatedPersonId])
  @@map("person_relationship")
}

/// A single contact channel (email address or phone number) for a Person.
/// `normalizedValue` holds the app-normalized form (E.164 phone, lowercased
/// email) used for search and duplicate detection across the ward;
/// `value` retains what was originally entered. Consent is tracked
/// separately via ContactConsent and is never inferred from this record.
model ContactMethod {
  id              String            @id @default(uuid())
  personId        String            @map("person_id")
  type            ContactMethodType
  value           String
  normalizedValue String?           @map("normalized_value")
  isPrimary       Boolean           @default(false) @map("is_primary")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  archivedAt      DateTime?         @map("archived_at")

  person             Person              @relation(fields: [personId], references: [id], onDelete: Cascade)
  consent            ContactConsent?
  deliveryRecipients DeliveryRecipient[]

  @@unique([personId, type, value])
  @@index([personId])
  @@index([normalizedValue])
  @@map("contact_method")
}

/// The current consent state for a single contact method. Defaults to
/// `Unknown` — consent is NEVER inferred from audience membership or any
/// other record (see AGENTS.md #8). Changes to this row should be paired
/// with an AuditEvent so the consent history remains reconstructable even
/// though this table itself stores only current state.
model ContactConsent {
  id               String        @id @default(uuid())
  contactMethodId  String        @unique @map("contact_method_id")
  status           ConsentStatus @default(Unknown)
  source           String?
  recordedByUserId String?       @map("recorded_by_user_id")
  grantedAt        DateTime?     @map("granted_at")
  revokedAt        DateTime?     @map("revoked_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  contactMethod ContactMethod    @relation(fields: [contactMethodId], references: [id], onDelete: Cascade)
  recordedBy    ApplicationUser? @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@map("contact_consent")
}

// ---------------------------------------------------------------------------
// Audiences and communication destinations
// ---------------------------------------------------------------------------

/// A configurable, ward-defined group of people (e.g. "Young Women" or an
/// ad hoc list). Group names are never hardcoded into business logic —
/// see prisma/seed.ts for optional illustrative examples only.
model AudienceGroup {
  id          String    @id @default(uuid())
  wardId      String    @map("ward_id")
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  archivedAt  DateTime? @map("archived_at")

  ward         Ward                  @relation(fields: [wardId], references: [id], onDelete: Restrict)
  members      AudienceGroupMember[]
  destinations AudienceDestination[]
  campaignUses CampaignAudience[]

  @@unique([wardId, name])
  @@index([wardId, archivedAt])
  @@map("audience_group")
}

/// Many-to-many membership of a Person in an AudienceGroup.
model AudienceGroupMember {
  id              String   @id @default(uuid())
  audienceGroupId String   @map("audience_group_id")
  personId        String   @map("person_id")
  addedByUserId   String?  @map("added_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  audienceGroup AudienceGroup    @relation(fields: [audienceGroupId], references: [id], onDelete: Cascade)
  person        Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  addedBy       ApplicationUser? @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@unique([audienceGroupId, personId])
  @@index([personId])
  @@map("audience_group_member")
}

/// A configured place messages can be sent (an email list address, an SMS
/// number pool, a Facebook Page, etc.). Only a non-secret provider
/// reference and non-secret configuration are stored here — actual
/// provider credentials belong in a managed secret store (see
/// .cursor/rules/security.mdc and phases/09-provider-integrations.md), not
/// in this table or in source control. Destinations are archived, never
/// deleted, once delivery history exists (enforced by the Phase 7/8
/// services that reference this table).
model CommunicationDestination {
  id                       String               @id @default(uuid())
  wardId                   String               @map("ward_id")
  channel                  CommunicationChannel
  name                     String
  providerAccountReference String?              @map("provider_account_reference")
  configuration            Json?
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  archivedAt               DateTime?            @map("archived_at")

  ward               Ward                  @relation(fields: [wardId], references: [id], onDelete: Restrict)
  audienceLinks      AudienceDestination[]
  campaignUses       CampaignDestination[]
  deliveryRecipients DeliveryRecipient[]

  @@unique([wardId, name])
  @@index([wardId, channel])
  @@map("communication_destination")
}

/// Many-to-many wiring between AudienceGroup and CommunicationDestination.
model AudienceDestination {
  id              String   @id @default(uuid())
  audienceGroupId String   @map("audience_group_id")
  destinationId   String   @map("destination_id")
  createdAt       DateTime @default(now()) @map("created_at")

  audienceGroup AudienceGroup            @relation(fields: [audienceGroupId], references: [id], onDelete: Cascade)
  destination   CommunicationDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([audienceGroupId, destinationId])
  @@index([destinationId])
  @@map("audience_destination")
}

// ---------------------------------------------------------------------------
// Campaigns (Phase 7 — drafting only; no real provider sending yet)
// ---------------------------------------------------------------------------

/// A communication campaign container. All actual content (message, image,
/// per-channel and per-audience overrides) lives on `CampaignVersion` and
/// its children so that a campaign's history across edits/rejections stays
/// reconstructable — `Campaign` itself only tracks identity and lifecycle
/// status. See `packages/domain/src/campaigns/campaign-status.ts` for the
/// allowed status transitions.
model Campaign {
  id              String         @id @default(uuid())
  wardId          String         @map("ward_id")
  name            String
  status          CampaignStatus @default(Draft)
  createdByUserId String?        @map("created_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  archivedAt      DateTime?      @map("archived_at")

  ward            Ward               @relation(fields: [wardId], references: [id], onDelete: Restrict)
  createdBy       ApplicationUser?   @relation("CampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  versions        CampaignVersion[]
  assets          CampaignAsset[]
  approvals       CampaignApproval[]
  schedules       CampaignSchedule[]
  deliveryBatches DeliveryBatch[]

  @@index([wardId, status])
  @@index([wardId, archivedAt])
  @@map("campaign")
}

/// A single edit-history snapshot of a campaign's content. The version with
/// the highest `versionNumber` for a campaign is the current one. A new
/// version is created (rather than mutating an existing one) once a version
/// has ever been submitted for approval, so approvers and audit history
/// always see exactly what was reviewed — see docs/campaigns.md
/// ("audience version independence").
model CampaignVersion {
  id               String   @id @default(uuid())
  campaignId       String   @map("campaign_id")
  versionNumber    Int      @map("version_number")
  baseMessage      String?  @map("base_message")
  baseImageAssetId String?  @map("base_image_asset_id")
  createdByUserId  String?  @map("created_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  campaign        Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  baseImageAsset  CampaignAsset?           @relation("CampaignVersionBaseImage", fields: [baseImageAssetId], references: [id], onDelete: SetNull)
  createdBy       ApplicationUser?         @relation("CampaignVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  channelVersions CampaignChannelVersion[]
  audiences       CampaignAudience[]
  destinations    CampaignDestination[]
  approvals       CampaignApproval[]
  deliveryBatches DeliveryBatch[]

  @@unique([campaignId, versionNumber])
  @@map("campaign_version")
}

/// A per-channel text override for a campaign version (e.g. a shorter SMS
/// variant of the base message). Falls back to `CampaignVersion.baseMessage`
/// when no row exists for a channel.
model CampaignChannelVersion {
  id                String               @id @default(uuid())
  campaignVersionId String               @map("campaign_version_id")
  channel           CommunicationChannel
  text              String
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  campaignVersion CampaignVersion @relation(fields: [campaignVersionId], references: [id], onDelete: Cascade)

  @@unique([campaignVersionId, channel])
  @@map("campaign_channel_version")
}

/// An image (or other media) uploaded for use in a campaign. Only a
/// storage reference is kept here — actual file storage is a Phase 9+
/// concern (see .cursor/rules/architecture.mdc: "use adapters for ...
/// storage"). `altText` is required so every campaign image ships with
/// useful alt text (.cursor/rules/ui.mdc).
model CampaignAsset {
  id               String   @id @default(uuid())
  campaignId       String   @map("campaign_id")
  storageReference String   @map("storage_reference")
  contentType      String   @map("content_type")
  altText          String   @map("alt_text")
  createdAt        DateTime @default(now()) @map("created_at")

  campaign               Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  usedAsBaseImageIn      CampaignVersion[]  @relation("CampaignVersionBaseImage")
  usedAsAudienceOverride CampaignAudience[] @relation("CampaignAudienceOverrideImage")

  @@index([campaignId])
  @@map("campaign_asset")
}

/// One of the audiences selected for a specific campaign version, with
/// optional audience-specific text/image overrides. Scoped to
/// `campaignVersionId` (not `campaignId`) so overrides never leak between
/// versions — editing version 2 can never change what version 1's
/// approvers saw.
model CampaignAudience {
  id                   String   @id @default(uuid())
  campaignVersionId    String   @map("campaign_version_id")
  audienceGroupId      String   @map("audience_group_id")
  overrideText         String?  @map("override_text")
  overrideImageAssetId String?  @map("override_image_asset_id")
  createdAt            DateTime @default(now()) @map("created_at")

  campaignVersion    CampaignVersion @relation(fields: [campaignVersionId], references: [id], onDelete: Cascade)
  audienceGroup      AudienceGroup   @relation(fields: [audienceGroupId], references: [id], onDelete: Restrict)
  overrideImageAsset CampaignAsset?  @relation("CampaignAudienceOverrideImage", fields: [overrideImageAssetId], references: [id], onDelete: SetNull)

  @@unique([campaignVersionId, audienceGroupId])
  @@index([audienceGroupId])
  @@map("campaign_audience")
}

/// The communication destinations resolved for a campaign version (the
/// deduplicated union of active destinations linked to its selected
/// audiences at the time of resolution). Recomputed whenever the version's
/// audience selection changes while still editable; frozen once submitted.
model CampaignDestination {
  id                String   @id @default(uuid())
  campaignVersionId String   @map("campaign_version_id")
  destinationId     String   @map("destination_id")
  createdAt         DateTime @default(now()) @map("created_at")

  campaignVersion CampaignVersion          @relation(fields: [campaignVersionId], references: [id], onDelete: Cascade)
  destination     CommunicationDestination @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@unique([campaignVersionId, destinationId])
  @@index([destinationId])
  @@map("campaign_destination")
}

/// A single approve/reject decision on a submitted campaign version. Never
/// updated after creation — a resubmission after rejection produces a new
/// row, preserving the full approval history.
model CampaignApproval {
  id                String                   @id @default(uuid())
  campaignId        String                   @map("campaign_id")
  campaignVersionId String                   @map("campaign_version_id")
  approverUserId    String?                  @map("approver_user_id")
  decision          CampaignApprovalDecision
  comment           String?
  decidedAt         DateTime                 @default(now()) @map("decided_at")

  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignVersion CampaignVersion  @relation(fields: [campaignVersionId], references: [id], onDelete: Cascade)
  approver        ApplicationUser? @relation("CampaignApprovalApprover", fields: [approverUserId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@map("campaign_approval")
}

/// A requested send time for an approved campaign. No scheduler/trigger
/// logic reads this table automatically yet in Phase 7 or Phase 8 — an
/// operator (or, in a later phase, a scheduled job) calls the same
/// `POST /campaigns/:id/send-now` / delivery-engine start path once
/// `scheduledFor` has passed. See docs/delivery.md ("known gaps").
model CampaignSchedule {
  id              String    @id @default(uuid())
  campaignId      String    @map("campaign_id")
  scheduledFor    DateTime  @map("scheduled_for")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  cancelledAt     DateTime? @map("cancelled_at")

  campaign  Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy ApplicationUser? @relation("CampaignScheduleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@map("campaign_schedule")
}

// ---------------------------------------------------------------------------
// Delivery engine (Phase 8 — simulated provider adapters only)
// ---------------------------------------------------------------------------

/// One send execution of a single CampaignVersion. `idempotencyKey` is
/// derived from (campaignId, campaignVersionId) so retrying send reuses
/// the existing batch instead of expanding recipients again (AGENTS.md #6/#7).
model DeliveryBatch {
  id                String              @id @default(uuid())
  wardId            String              @map("ward_id")
  campaignId        String              @map("campaign_id")
  campaignVersionId String              @map("campaign_version_id")
  idempotencyKey    String              @map("idempotency_key")
  status            DeliveryBatchStatus @default(Pending)
  totalRecipients   Int                 @default(0) @map("total_recipients")
  sentCount         Int                 @default(0) @map("sent_count")
  deadLetteredCount Int                 @default(0) @map("dead_lettered_count")
  skippedCount      Int                 @default(0) @map("skipped_count")
  createdByUserId   String?             @map("created_by_user_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  completedAt       DateTime?           @map("completed_at")

  ward            Ward                @relation(fields: [wardId], references: [id], onDelete: Restrict)
  campaign        Campaign            @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  campaignVersion CampaignVersion     @relation(fields: [campaignVersionId], references: [id], onDelete: Restrict)
  createdByUser   ApplicationUser?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  recipients      DeliveryRecipient[]

  @@unique([wardId, idempotencyKey])
  @@index([campaignId])
  @@map("delivery_batch")
}

/// One expanded (person, channel) or (Facebook Page destination, channel)
/// recipient within a DeliveryBatch. Unique per batch + idempotencyKey so
/// re-expansion never duplicates rows.
model DeliveryRecipient {
  id                    String                  @id @default(uuid())
  deliveryBatchId       String                  @map("delivery_batch_id")
  personId              String?                 @map("person_id")
  channel               CommunicationChannel
  destinationId         String?                 @map("destination_id")
  contactMethodId       String?                 @map("contact_method_id")
  sourceAudienceGroupId String?                 @map("source_audience_group_id")
  idempotencyKey        String                  @map("idempotency_key")
  status                DeliveryRecipientStatus @default(Pending)
  resolvedText          String?                 @map("resolved_text")
  resolvedImageAssetId  String?                 @map("resolved_image_asset_id")
  skipReason            String?                 @map("skip_reason")
  attemptCount          Int                     @default(0) @map("attempt_count")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  deliveryBatch DeliveryBatch             @relation(fields: [deliveryBatchId], references: [id], onDelete: Cascade)
  person        Person?                   @relation(fields: [personId], references: [id], onDelete: SetNull)
  destination   CommunicationDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  contactMethod ContactMethod?            @relation(fields: [contactMethodId], references: [id], onDelete: SetNull)
  attempts      DeliveryAttempt[]

  @@unique([deliveryBatchId, idempotencyKey])
  @@index([deliveryBatchId, status])
  @@index([personId])
  @@map("delivery_recipient")
}

/// Append-only provider-call attempt for one DeliveryRecipient.
model DeliveryAttempt {
  id                  String                @id @default(uuid())
  deliveryRecipientId String                @map("delivery_recipient_id")
  attemptNumber       Int                   @map("attempt_number")
  status              DeliveryAttemptStatus
  providerMessageId   String?               @map("provider_message_id")
  errorCode           String?               @map("error_code")
  errorMessage        String?               @map("error_message")
  attemptedAt         DateTime              @default(now()) @map("attempted_at")

  deliveryRecipient DeliveryRecipient @relation(fields: [deliveryRecipientId], references: [id], onDelete: Cascade)

  @@unique([deliveryRecipientId, attemptNumber])
  @@map("delivery_attempt")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// An immutable audit log entry. `entityId` is intentionally a plain string
/// rather than a foreign key so audit history survives even if the
/// referenced record is later erased (e.g. a data-retention deletion hook
/// for a Person). `actorUserId` uses SetNull on delete for the same
/// reason: the event itself must never be lost, only the actor link may
/// become unknown. `metadata` must never contain secrets, password/ward
/// code values, or more personal data than the action itself requires (see
/// .cursor/rules/security.mdc — redact personal data from logs).
model AuditEvent {
  id          String   @id @default(uuid())
  wardId      String?  @map("ward_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  ward  Ward?            @relation(fields: [wardId], references: [id], onDelete: SetNull)
  actor ApplicationUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([wardId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_event")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Gender {
  Male
  Female
  NotSpecified
}

/// Directed family relationship types. Intentionally broad and not tied to
/// one permanent family shape so divorce, remarriage, guardianship, and
/// non-nuclear households are representable.
enum RelationshipType {
  Husband
  Wife
  Son
  Daughter
  Parent
  Child
  Spouse
  Guardian
  Dependent
  Other
  NotSpecified
}

/// Administrative role within a household, separate from family
/// relationship type.
enum HouseholdRole {
  Head
  Member
}

enum ContactMethodType {
  Email
  Phone
}

/// Consent is never inferred; `Unknown` is the default until a person (or
/// their guardian) explicitly grants, denies, or withdraws consent.
enum ConsentStatus {
  Unknown
  Granted
  Denied
  Withdrawn
}

enum CommunicationChannel {
  Email
  Sms
  FacebookPage
}

/// Campaign lifecycle status. See
/// `packages/domain/src/campaigns/campaign-status.ts` for the allowed
/// transition graph — `Sent` and `Cancelled` are terminal.
enum CampaignStatus {
  Draft
  PendingApproval
  Approved
  Rejected
  Scheduled
  Sending
  Sent
  Cancelled
}

enum CampaignApprovalDecision {
  Approved
  Rejected
}

enum DeliveryBatchStatus {
  Pending
  Running
  Completed
  PartialFailure
  Failed
}

enum DeliveryRecipientStatus {
  Pending
  Queued
  Sending
  Sent
  Retrying
  DeadLettered
  Skipped
}

enum DeliveryAttemptStatus {
  Succeeded
  Failed
  PermanentFailure
}
